# Server Config
APP_NAME="NovaCut AI"
APP_VERSION="1.0.0"
DEBUG=False

# API Keys (Add yours in Render Environment Variables)
GEMINI_API_KEY=""
GROQ_API_KEY=""
GOOGLE_CLIENT_ID=""

# Secret Keys
# Generate a strong key for production (e.g., openssl rand -hex 32)
SECRET_KEY="changeme-use-strong-random-key-in-production-min-32-chars"

# CORS configuration
# We allow all origins by default in the render.yaml for easy deployment
CORS_ORIGINS='["*"]'
